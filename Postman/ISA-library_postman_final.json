      "key": "csrfToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Get CSRF token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login page loaded', function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "});",
              "",
              "const html = pm.response.text();",
              "const match = html.match(/name=[\"']_csrf[\"'][^>]*value=[\"']([^\"']+)[\"']/i);",
              "pm.test('CSRF token found', function () {",
              "    pm.expect(match).to.not.eql(null);",
              "});",
              "if (match) {",
              "    pm.collectionVariables.set('csrfToken', match[1]);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/login",
        "description": "Učitava login stranicu i automatski iz HTML-a čuva Spring Security CSRF token u collection variable `csrfToken`. Postman takođe čuva session cookie."
      }
    },
    {
      "name": "01 - Login as admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login successful', function () {",
              "    pm.expect([200, 302]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "admin",
              "type": "text"
            },
            {
              "key": "password",
              "value": "admin123",
              "type": "text"
            },
            {
              "key": "_csrf",
              "value": "{{csrfToken}}",
              "type": "text"
            }
          ]
        },
        "url": "{{baseUrl}}/login",
        "description": "Prijava administratorskog korisnika. Spring Security koristi JSESSIONID sesiju, koju Postman automatski čuva i šalje u sledećim zahtevima."
      }
    },
