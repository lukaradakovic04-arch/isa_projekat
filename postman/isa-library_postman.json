{
  "info": {
    "_postman_id": "7c606c55-fb88-4d90-8be4-isa-library",
    "name": "ISA Library - Postman Collection",
    "description": "Spring MVC session-based API testovi. Prvo pokrenuti login. Postman ce sacuvati JSESSIONID cookie.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "bookId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 - Login as admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "admin",
              "type": "text"
            },
            {
              "key": "password",
              "value": "admin123",
              "type": "text"
            }
          ]
        },
        "url": "{{baseUrl}}/login",
        "description": "Login forma. Postman cuva JSESSIONID cookie."
      }
    },
    {
      "name": "02 - Get all books",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/books"
      }
    },
    {
      "name": "03 - Create book",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('bookId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Code\",\n  \"isbn\": \"9780132350884\",\n  \"publicationYear\": 2008,\n  \"categoryId\": 2,\n  \"authorIds\": [\n    2\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/books"
      }
    },
    {
      "name": "04 - Get created book",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/books/{{bookId}}"
      }
    },
    {
      "name": "05 - Update created book",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Code - updated\",\n  \"isbn\": \"9780132350884\",\n  \"publicationYear\": 2008,\n  \"categoryId\": 2,\n  \"authorIds\": [\n    2\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/books/{{bookId}}"
      }
    },
    {
      "name": "06 - Delete created book",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/books/{{bookId}}"
      }
    }
  ]
}